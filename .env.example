# StayMate Full-Stack Environment Configuration
# ===============================================

# -----------------
# Backend (server/.env)
# -----------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database: MongoDB Atlas URI or local MongoDB connection string.
# (Leave empty in dev to automatically use in-memory MongoDB)
MONGODB_URI=

# Authentication
JWT_SECRET=dev-staymate-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=staymate_token

# Admin Initial Credentials
ADMIN_NAME=StayMate Admin
ADMIN_EMAIL=admin@staymate.app
ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO=true

# Cloudinary (Optional - uploads save to server/uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email Delivery (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=StayMate <no-reply@staymate.app>

# -----------------
# Frontend (client/.env)
# -----------------
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_MAPS_API_KEY=
VITE_DEMO_MODE=true
