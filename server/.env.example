# Server
PORT=5000
NODE_ENV=development

# Frontend URL used for CORS, password reset links and cookies
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string. Leave blank in development to use an
# in-memory MongoDB instance (data resets on restart).
MONGODB_URI=

# Authentication (use a long random string in production)
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=staymate_token

# Initial administrator account (used by `npm run seed`)
ADMIN_NAME=StayMate Admin
ADMIN_EMAIL=admin@staymate.app
ADMIN_PASSWORD=ChangeMe123!

# Optional: seed clearly-labelled demo listings. Set to false for production.
SEED_DEMO=true

# Optional Cloudinary image storage. Without these, uploads are saved to
# server/uploads on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP email delivery for password resets and notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=StayMate <no-reply@staymate.app>
