# Base URL of the StayMate API (include /api)
VITE_API_URL=http://localhost:5000/api

# Optional Google Maps Embed API key. If omitted, coordinates open in an
# OpenStreetMap embed, and listings without coordinates show a locality card.
VITE_GOOGLE_MAPS_API_KEY=

# Set to true only for local demos to show demo account shortcuts on login.
VITE_DEMO_MODE=true
